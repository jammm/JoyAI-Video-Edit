# Optional conda activation. Leave unset if you activate the environment manually.
JOYAI_CONDA_SH=/path/to/conda/etc/profile.d/conda.sh
JOYAI_CONDA_ENV=joyai-video-edit

# Optional OpenAI-compatible prompt-enhancement endpoint.
# Do not commit real keys.
PE_API_KEY=
PE_BASE_URL=https://your-openai-compatible-endpoint/v1
PE_MODEL=

# Optional runtime overrides.
JOYAI_HOST=0.0.0.0
JOYAI_PORT=8080
JOYOMNI_DEVICE=cuda:0
CUDA_VISIBLE_DEVICES=0
# On ROCm, comment out CUDA_VISIBLE_DEVICES above and use only the physical AMD
# GPU index or ROCr UUID here. The selected device is still addressed as
# logical cuda:0. A UUID is safer when numbering may differ between tools.
# ROCR_VISIBLE_DEVICES=0
# The ROCm launcher defaults below are the qualified MI350X two-step preset.
# Override them only for A/B qualification.
# JOYOMNI_FP8_IMG=1
# JOYOMNI_FP8_TXT=1
# JOYOMNI_STATEFUL_VAE=0
# JOYOMNI_EXPLICIT_STREAMS=1
# JOYOMNI_CACHE_LAST_DENOISE_KV=1
# JOYOMNI_CLEAN_KV_PREFIX_LAYERS=24
# Exact clean-KV fidelity mode (slower): JOYOMNI_CACHE_LAST_DENOISE_KV=0
# Warmed-throughput DiT compile defaults. Set JOYOMNI_DIT_COMPILE_MODE to an
# empty string to disable the compiled core for an eager A/B run.
# JOYOMNI_DIT_COMPILE_MODE=default
# JOYOMNI_DIT_COMPILE_FULLGRAPH=1
# JOYOMNI_DIT_COMPILE_DYNAMIC=1

# Optional checkpoint overrides.
# JOYAI_CHECKPOINT_ROOT=/path/to/checkpoints
# JOYAI_DIT_CKPT=/path/to/joyai_video_edit_dit_0804.pth
# JOYAI_VAE_CKPT=/path/to/vae
# JOYAI_TEXT_ENCODER_CKPT=/path/to/MiMo-VL-7B-RL-2508
# JOYAI_FACE_DETECTOR_ONNX=/path/to/face_detection_yunet_2023mar.onnx
# JOYAI_PERSON_DETECTOR_PT=/path/to/yolov8n.pt
# JOYAI_PERSON_DETECTOR_ONNX=/path/to/yolov8n.onnx
